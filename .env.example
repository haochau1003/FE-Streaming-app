# Copy to .env (gitignored) and fill in. app.config.ts reads these into expo.extra.

# Backend HTTP base URL (no trailing slash). run.py defaults to :5001
# (avoid :5000 — taken by macOS AirPlay Receiver / Control Center on recent macOS).
API_BASE=http://localhost:5001

# SocketIO base URL. Usually identical to API_BASE.
SOCKET_URL=http://localhost:5001

# Server-mirrored upload limits (truth lives on the backend).
MEDIA_MAX_SIZE_MB=100
MEDIA_QUOTA_MB_PER_USER=1024

# Comma-separated list of accepted mimetypes (server-enforced; this mirrors it for client pre-flight).
MEDIA_ALLOWED_MIMETYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg,audio/mpeg,audio/ogg,audio/wav

# Presigned URL TTL in seconds. We refetch ~30s before expiry.
MEDIA_PRESIGNED_TTL_SECONDS=300

# Upload rate limit window (per user). Mirrors server token bucket.
MEDIA_UPLOAD_LIMIT_PER_MINUTE=10
